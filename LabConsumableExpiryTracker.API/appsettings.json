{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lab_tracker;Username=postgres;Password=hitam123"
  },
  
  "JwtSettings": {
    "SecretKey": "lfur8wUmrA3uTZLKps0RRHzm7LpcXXMly+n3QxvZwzM=",
    "Issuer": "LabConsumableExpiryTracker",
    "Audience": "LabConsumableExpiryTrackerClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
