# Copy to .env, replace every placeholder, and keep .env private.
POSTGRES_DB=lab_tracker
POSTGRES_USER=lab_tracker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
JWT_ISSUER=LabConsumableExpiryTracker
JWT_AUDIENCE=LabConsumableExpiryTrackerClient

# Initial seeded accounts are created at startup; set unique strong passwords.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_USERS_PASSWORD=replace-with-a-strong-seed-user-password
